doctype html
html
  head
    meta(charset='utf-8')
    title Editar Cliente
    link(rel='stylesheet', href='https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-alpha.2/css/bootstrap.min.css')

  body
    .modal-dialog
      .modal-content
        .modal-header
          h4.modal-title Editar Cliente
        .modal-body
          if error
            .alert.alert-danger(role='alert')= error
          form(role='form', method='POST', action='/clientes/' + client.id + '/edit')
            .form-group
              label(for='name') Nome:
              input#name.form-control(type='text', placeholder='nome', name='name', value=client.name)
            .form-group
              label(for='email') Email:
              input#email.form-control(type='email', placeholder='name@email.com', name='email', value=client.email)
            .d-flex.justify-content-between
              a.btn.btn-outline-secondary(href='/clientes') Voltar
              button.btn.btn-primary(type='submit') Atualizar Cliente
              